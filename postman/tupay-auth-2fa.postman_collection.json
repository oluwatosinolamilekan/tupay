{
  "info": {
    "_postman_id": "5f4aef08-6d96-4f38-90b0-2b6d6b90d1d2",
    "name": "Tupay Auth + 2FA",
    "description": "Focused collection for testing /api/login and /api/2fa/verify locally. Run Login first, then Verify 2FA. The Verify 2FA request generates the current TOTP code from two_factor_secret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "device_name",
      "value": "postman",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "two_factor_session_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "two_factor_secret",
      "value": "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP",
      "type": "string"
    },
    {
      "key": "two_factor_code",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "if (json.access_token) {",
              "  pm.collectionVariables.set('access_token', json.access_token);",
              "}",
              "",
              "if (json.two_factor && json.two_factor.session_token) {",
              "  pm.collectionVariables.set('two_factor_session_token', json.two_factor.session_token);",
              "}",
              "",
              "if (json.two_factor && json.two_factor.secret) {",
              "  pm.collectionVariables.set('two_factor_secret', json.two_factor.secret);",
              "}",
              "",
              "console.log('access_token:', pm.collectionVariables.get('access_token'));",
              "console.log('two_factor_session_token:', pm.collectionVariables.get('two_factor_session_token'));",
              "console.log('two_factor_secret:', pm.collectionVariables.get('two_factor_secret'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Logs in and saves access_token and two_factor_session_token into collection variables."
      },
      "response": []
    },
    {
      "name": "Verify 2FA",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.collectionVariables.get('two_factor_secret');",
              "",
              "function bytesToWordArray(bytes) {",
              "  const words = [];",
              "  for (let i = 0; i < bytes.length; i += 1) {",
              "    words[i >>> 2] |= bytes[i] << (24 - (i % 4) * 8);",
              "  }",
              "  return CryptoJS.lib.WordArray.create(words, bytes.length);",
              "}",
              "",
              "function base32Decode(value) {",
              "  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
              "  const normalized = value.replace(/=+$/g, '').replace(/\\s+/g, '').toUpperCase();",
              "  let buffer = 0;",
              "  let bitsLeft = 0;",
              "  const bytes = [];",
              "",
              "  for (const character of normalized) {",
              "    const index = alphabet.indexOf(character);",
              "    if (index === -1) continue;",
              "    buffer = (buffer << 5) | index;",
              "    bitsLeft += 5;",
              "    if (bitsLeft >= 8) {",
              "      bitsLeft -= 8;",
              "      bytes.push((buffer >> bitsLeft) & 0xff);",
              "    }",
              "  }",
              "",
              "  return bytes;",
              "}",
              "",
              "function currentTotpCode(base32Secret) {",
              "  const key = bytesToWordArray(base32Decode(base32Secret));",
              "  let counter = Math.floor(Date.now() / 1000 / 30);",
              "  const message = [];",
              "",
              "  for (let i = 7; i >= 0; i -= 1) {",
              "    message[i] = counter & 0xff;",
              "    counter = Math.floor(counter / 256);",
              "  }",
              "",
              "  const hmac = CryptoJS.HmacSHA1(bytesToWordArray(message), key);",
              "  const bytes = [];",
              "",
              "  for (let i = 0; i < hmac.sigBytes; i += 1) {",
              "    bytes.push((hmac.words[i >>> 2] >>> (24 - (i % 4) * 8)) & 0xff);",
              "  }",
              "",
              "  const offset = bytes[19] & 0x0f;",
              "  const binary = ((bytes[offset] & 0x7f) << 24) |",
              "    ((bytes[offset + 1] & 0xff) << 16) |",
              "    ((bytes[offset + 2] & 0xff) << 8) |",
              "    (bytes[offset + 3] & 0xff);",
              "",
              "  return String(binary % 1000000).padStart(6, '0');",
              "}",
              "",
              "if (!secret) {",
              "  throw new Error('Missing two_factor_secret. Run Login first or set two_factor_secret manually.');",
              "}",
              "",
              "const code = currentTotpCode(secret);",
              "pm.collectionVariables.set('two_factor_code', code);",
              "console.log('Generated two_factor_code:', code);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('2FA verify returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "console.log('two_factor_code used:', pm.collectionVariables.get('two_factor_code'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{two_factor_code}}\",\n  \"session_token\": \"{{two_factor_session_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/2fa/verify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "2fa",
            "verify"
          ]
        },
        "description": "Generates the current 6-digit two_factor_code from two_factor_secret, then verifies the session token returned by Login."
      },
      "response": []
    }
  ]
}
