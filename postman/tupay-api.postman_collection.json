    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Settlement Webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.request.body.raw;",
                  "const secret = pm.collectionVariables.get('settlement_webhook_secret');",
                  "const signature = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Tupay-Signature', value: signature });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tupay-Signature",
                "value": ""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_reference\": \"{{provider_reference}}\",\n  \"account_id\": {{cny_account_id}},\n  \"amount_minor\": 12500,\n  \"currency\": \"CNY\",\n  \"status\": \"completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
