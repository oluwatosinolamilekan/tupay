          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.email) pm.collectionVariables.set('email', json.email);",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.two_factor?.session_token) pm.collectionVariables.set('two_factor_session_token', json.two_factor.session_token);",
                  "if (json.two_factor?.secret) pm.collectionVariables.set('two_factor_secret', json.two_factor.secret);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
