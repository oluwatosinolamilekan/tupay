        {
          "name": "Verify 2FA",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.collectionVariables.get('two_factor_secret');",
                  "",
                  "function bytesToWordArray(bytes) {",
                  "  const words = [];",
                  "  for (let i = 0; i < bytes.length; i += 1) {",
                  "    words[i >>> 2] |= bytes[i] << (24 - (i % 4) * 8);",
                  "  }",
                  "  return CryptoJS.lib.WordArray.create(words, bytes.length);",
                  "}",
                  "",
                  "function base32Decode(value) {",
                  "  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "  const normalized = value.replace(/=+$/g, '').replace(/\\s+/g, '').toUpperCase();",
                  "  let buffer = 0;",
                  "  let bitsLeft = 0;",
                  "  const bytes = [];",
                  "",
                  "  for (const character of normalized) {",
                  "    const index = alphabet.indexOf(character);",
                  "    if (index === -1) continue;",
                  "    buffer = (buffer << 5) | index;",
                  "    bitsLeft += 5;",
                  "    if (bitsLeft >= 8) {",
                  "      bitsLeft -= 8;",
                  "      bytes.push((buffer >> bitsLeft) & 0xff);",
                  "    }",
                  "  }",
                  "",
                  "  return bytes;",
                  "}",
                  "",
                  "function currentTotpCode(base32Secret) {",
                  "  const key = bytesToWordArray(base32Decode(base32Secret));",
                  "  let counter = Math.floor(Date.now() / 1000 / 30);",
                  "  const message = [];",
                  "  for (let i = 7; i >= 0; i -= 1) {",
                  "    message[i] = counter & 0xff;",
                  "    counter = Math.floor(counter / 256);",
                  "  }",
                  "",
                  "  const hmac = CryptoJS.HmacSHA1(bytesToWordArray(message), key);",
                  "  const bytes = [];",
                  "  for (let i = 0; i < hmac.sigBytes; i += 1) {",
                  "    bytes.push((hmac.words[i >>> 2] >>> (24 - (i % 4) * 8)) & 0xff);",
                  "  }",
                  "",
                  "  const offset = bytes[19] & 0x0f;",
                  "  const binary = ((bytes[offset] & 0x7f) << 24) |",
                  "    ((bytes[offset + 1] & 0xff) << 16) |",
                  "    ((bytes[offset + 2] & 0xff) << 8) |",
                  "    (bytes[offset + 3] & 0xff);",
                  "",
                  "  return String(binary % 1000000).padStart(6, '0');",
                  "}",
                  "",
                  "if (secret) {",
                  "  const code = currentTotpCode(secret);",
                  "  pm.collectionVariables.set('two_factor_code', code);",
                  "  console.log('Generated two_factor_code:', code);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2FA accepted', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('verified_two_factor_session_token', pm.collectionVariables.get('two_factor_session_token'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
